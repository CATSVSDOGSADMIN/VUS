<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ghost Hub · Cinema</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #f5f0ff;
        color: #1e1028;
    }

    body::before {
        content: '';
        position: fixed;
        inset: 0;
        background:
            radial-gradient(ellipse at 20% 50%, rgba(180, 140, 220, 0.08) 0%, transparent 60%),
            radial-gradient(ellipse at 80% 50%, rgba(180, 140, 220, 0.08) 0%, transparent 60%);
        pointer-events: none;
        z-index: -1;
    }

    /* --- layout shell: sidebar + content --- */
    .app-shell {
        display: flex;
        min-height: 100vh;
    }

    /* --- sidebar --- */
    #categorySidebar {
        width: 220px;
        flex-shrink: 0;
        background: linear-gradient(180deg, #ffffff, #f3edfd);
        border-right: 3px solid #b392d0;
        padding: 20px 14px;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
    }
    #categorySidebar h2 {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #7a4a9e;
        margin-bottom: 14px;
        padding-left: 6px;
    }
    #categorySidebar ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    #categorySidebar button {
        width: 100%;
        text-align: left;
        background: transparent;
        border: none;
        padding: 10px 12px;
        border-radius: 10px;
        font-size: 0.92rem;
        font-weight: 500;
        color: #3a2450;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: 0.15s;
    }
    #categorySidebar button:hover {
        background: #ede4fc;
        color: #2d1640;
    }
    #categorySidebar button.active {
        background: #7a4a9e;
        color: white;
    }
    #categorySidebar button i {
        width: 16px;
        text-align: center;
        color: #8a5aaa;
        flex-shrink: 0;
    }
    #categorySidebar button.active i {
        color: white;
    }

    /* --- main column --- */
    .main-col {
        flex: 1;
        min-width: 0;
    }

    header {
        background: linear-gradient(145deg, #ffffff, #f0eaff);
        padding: 24px 20px 18px;
        text-align: center;
        border-bottom: 3px solid #b392d0;
        box-shadow: 0 6px 30px rgba(90, 45, 122, 0.08);
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(4px);
    }

    h1 {
        font-size: 2.6rem;
        font-weight: 600;
        letter-spacing: 2px;
        color: #2d1640;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }
    h1 i { color: #7a4a9e; font-size: 2.2rem; }

    #searchBar {
        width: 92%;
        max-width: 540px;
        padding: 14px 22px;
        border: 2px solid #d5c0e8;
        border-radius: 60px;
        background: white;
        color: #1e1028;
        font-size: 1rem;
        outline: none;
        transition: 0.2s;
        box-shadow: 0 2px 12px rgba(90, 45, 122, 0.04);
    }
    #searchBar:focus {
        border-color: #9a6abf;
        box-shadow: 0 0 0 4px rgba(154, 106, 191, 0.15);
    }
    #searchBar::placeholder { color: #a08ab0; }

    .container {
        max-width: 1280px;
        margin: 30px auto;
        padding: 0 20px;
    }

    .category-header {
        font-size: 1.8rem;
        font-weight: 600;
        color: #2d1640;
        margin: 48px 0 20px;
        padding-bottom: 10px;
        border-bottom: 3px double #c8b0de;
        display: flex;
        align-items: center;
        gap: 16px;
        letter-spacing: 0.3px;
        scroll-margin-top: 110px; /* keeps header visible under sticky top bar */
    }
    .category-header i { color: #8a5aaa; font-size: 1.6rem; }

    .movie-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 22px;
    }

    .movie-card {
        background: white;
        border-radius: 20px 8px 20px 8px;
        box-shadow: 0 4px 16px rgba(90, 45, 122, 0.06), 0 1px 4px rgba(90, 45, 122, 0.04);
        border: 1px solid #e6dbf0;
        transition: 0.2s;
        position: relative;
        overflow: hidden;
    }
    .movie-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 30px rgba(90, 45, 122, 0.10);
        border-color: #b392d0;
    }

    .movie-card a {
        display: block;
        padding: 22px 16px;
        text-decoration: none;
        color: #1e1028;
        font-size: 0.95rem;
        font-weight: 500;
        text-align: center;
    }

    .rating {
        display: inline-block;
        font-size: 0.65rem;
        font-weight: 600;
        padding: 3px 12px;
        border-radius: 30px;
        margin-left: 5px;
        vertical-align: middle;
        letter-spacing: 0.3px;
        background: #ede4fc;
        color: #2d1640;
        border: 1px solid #d5c0e8;
    }

    footer {
        text-align: center;
        padding: 28px;
        margin-top: 60px;
        background: white;
        border-top: 2px solid #e6dbf0;
        color: #6a4a7a;
        font-size: 0.95rem;
    }

    .movie-card a::after {
        content: " \f08e";
        font-family: "Font Awesome 6 Free";
        font-weight: 400;
        font-size: 0.65rem;
        color: #a08ab0;
        margin-left: 4px;
        opacity: 0.6;
    }

    #emptyState {
        display: none;
        text-align: center;
        padding: 60px 20px;
        color: #8a6a9a;
        font-size: 1.05rem;
    }

    /* --- mobile: sidebar becomes a horizontal scroll strip up top --- */
    @media (max-width: 900px) {
        .app-shell { flex-direction: column; }
        #categorySidebar {
            width: 100%;
            height: auto;
            position: sticky;
            top: 0;
            z-index: 101;
            border-right: none;
            border-bottom: 3px solid #b392d0;
            padding: 10px 12px;
        }
        #categorySidebar h2 { display: none; }
        #categorySidebar ul {
            flex-direction: row;
            overflow-x: auto;
            gap: 8px;
            padding-bottom: 4px;
        }
        #categorySidebar li { flex-shrink: 0; }
        #categorySidebar button { white-space: nowrap; }
        header { position: static; }
    }

    @media (max-width: 700px) {
        h1 { font-size: 2rem; }
        .category-header { font-size: 1.4rem; }
        .movie-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); }
    }
</style>
