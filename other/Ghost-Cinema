<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ghost Hub · Cinema</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        /* ---------- CLEAN PURPLE & WHITE · MOVIE THEATER VIBE ---------- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: #f5f0ff;
            /* soft purple-white */
            color: #1e1028;
            cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 32 32"><path fill="%23f5f0ff" stroke="%235a2d7a" stroke-width="1.5" d="M16 2C10 2 6 7 6 13v10c0 2.5 1.8 3.8 3.5 3.2l2.5 3.3 2.5-3.8 2.5 3.8 2.5-3.3c1.7.6 3.5-.7 3.5-3.2V13c0-6-4-11-10-11z"/><circle cx="12" cy="13" r="2" fill="%235a2d7a"/><circle cx="20" cy="13" r="2" fill="%235a2d7a"/></svg>') 4 2, auto;
        }

        /* --- cinema curtains / gradient --- */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse at 20% 50%, rgba(180, 140, 220, 0.08) 0%, transparent 60%),
                radial-gradient(ellipse at 80% 50%, rgba(180, 140, 220, 0.08) 0%, transparent 60%);
            pointer-events: none;
            z-index: -1;
        }

        /* --- header --- */
        header {
            background: linear-gradient(145deg, #ffffff, #f0eaff);
            padding: 24px 20px 18px;
            text-align: center;
            border-bottom: 3px solid #b392d0;
            box-shadow: 0 6px 30px rgba(90, 45, 122, 0.08);
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(4px);
        }

        h1 {
            font-size: 2.6rem;
            font-weight: 600;
            letter-spacing: 2px;
            color: #2d1640;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            flex-wrap: wrap;
            margin-bottom: 16px;
        }
        h1 i {
            color: #7a4a9e;
            font-size: 2.2rem;
        }

        #searchBar {
            width: 92%;
            max-width: 540px;
            padding: 14px 22px;
            border: 2px solid #d5c0e8;
            border-radius: 60px;
            background: white;
            color: #1e1028;
            font-size: 1rem;
            outline: none;
            transition: 0.2s;
            box-shadow: 0 2px 12px rgba(90, 45, 122, 0.04);
        }
        #searchBar:focus {
            border-color: #9a6abf;
            box-shadow: 0 0 0 4px rgba(154, 106, 191, 0.15);
        }
        #searchBar::placeholder {
            color: #a08ab0;
        }

        /* --- container --- */
        .container {
            max-width: 1280px;
            margin: 30px auto;
            padding: 0 20px;
        }

        /* --- category headers (theater style) --- */
        .category-header {
            font-size: 1.8rem;
            font-weight: 600;
            color: #2d1640;
            margin: 48px 0 20px;
            padding-bottom: 10px;
            border-bottom: 3px double #c8b0de;
            display: flex;
            align-items: center;
            gap: 16px;
            letter-spacing: 0.3px;
        }
        .category-header i {
            color: #8a5aaa;
            font-size: 1.6rem;
        }

        /* --- movie grid (theater seating style) --- */
        .movie-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
            gap: 22px;
        }

        /* --- movie card (ticket / seat) --- */
        .movie-card {
            background: white;
            border-radius: 20px 8px 20px 8px;
            box-shadow: 0 4px 16px rgba(90, 45, 122, 0.06), 0 1px 4px rgba(90, 45, 122, 0.04);
            border: 1px solid #e6dbf0;
            transition: 0.2s;
            position: relative;
            overflow: hidden;
        }
        .movie-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 30px rgba(90, 45, 122, 0.10);
            border-color: #b392d0;
        }

        .movie-card a {
            display: block;
            padding: 16px 14px 18px;
            text-decoration: none;
            color: #1e1028;
            font-size: 0.95rem;
            font-weight: 500;
            text-align: center;
        }

        /* --- ghost poster (replaces images) --- */
        .movie-poster {
            width: 100%;
            height: 280px;
            background: linear-gradient(145deg, #f5efff, #ede4fc);
            border-radius: 16px 4px 16px 4px;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 5rem;
            color: #7a4a9e;
            border: 2px solid #e0d2ee;
            transition: 0.2s;
            box-shadow: inset 0 0 30px rgba(90, 45, 122, 0.02);
        }
        .movie-card:hover .movie-poster {
            border-color: #b392d0;
            background: linear-gradient(145deg, #f0eaff, #e6d8f5);
        }
        .movie-poster img {
            display: none;
        }

        /* --- tags & ratings --- */
        .new-tag,
        .rating {
            display: inline-block;
            font-size: 0.65rem;
            font-weight: 600;
            padding: 3px 12px;
            border-radius: 30px;
            margin-left: 5px;
            vertical-align: middle;
            letter-spacing: 0.3px;
        }
        .new-tag {
            background: #7a4a9e;
            color: white;
            box-shadow: 0 2px 8px rgba(122, 74, 158, 0.2);
        }
        .rating {
            background: #ede4fc;
            color: #2d1640;
            border: 1px solid #d5c0e8;
        }

        /* --- footer (theater lobby) --- */
        footer {
            text-align: center;
            padding: 28px;
            margin-top: 60px;
            background: white;
            border-top: 2px solid #e6dbf0;
            color: #6a4a7a;
            font-size: 0.95rem;
        }

        /* --- player overlay (KEPT but hidden — we now open in new tabs) --- */
        #videoPlayerOverlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 8, 25, 0.92);
            backdrop-filter: blur(6px);
            z-index: 2000;
            display: none !important;
            /* permanently hidden: all movies open in new tab */
            flex-direction: column;
        }
        #videoPlayerOverlay.active {
            display: none !important;
        }

        .player-header {
            padding: 14px 20px;
            background: rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            gap: 18px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }
        #backButton {
            background: #7a4a9e;
            color: white;
            border: none;
            padding: 10px 22px;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            transition: 0.15s;
        }
        #backButton:hover {
            background: #9a6abf;
        }
        #playerTitle {
            color: #e6dbf0;
            font-weight: 500;
            font-size: 1.1rem;
        }
        #playerIframe {
            flex: 1;
            width: 100%;
            border: none;
        }

        /* --- page2 button (disabled, but kept) --- */
        .page2-container {
            text-align: center;
            margin: 20px 0 10px;
            opacity: 0.5;
            pointer-events: none;
        }
        #page2Btn {
            display: inline-block;
            padding: 12px 32px;
            background: #e6dbf0;
            color: #5a3a6a;
            border-radius: 60px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            border: 1px solid #d5c0e8;
            cursor: default;
        }

        /* --- responsive --- */
        @media (max-width: 700px) {
            h1 {
                font-size: 2rem;
            }
            .category-header {
                font-size: 1.4rem;
            }
            .movie-grid {
                grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            }
            .movie-poster {
                height: 200px;
                font-size: 3.6rem;
            }
        }

        /* small helper: open-in-new-tab indicator (subtle) */
        .movie-card a[target="_blank"]::after {
            content: " \f08e";
            font-family: "Font Awesome 6 Free";
            font-weight: 400;
            font-size: 0.65rem;
            color: #a08ab0;
            margin-left: 4px;
            opacity: 0.6;
        }
        .movie-card a:not([target="_blank"])::after {
            content: " \f08e";
            font-family: "Font Awesome 6 Free";
            font-weight: 400;
            font-size: 0.65rem;
            color: #a08ab0;
            margin-left: 4px;
            opacity: 0.6;
        }
    </style>
