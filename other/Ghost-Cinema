// ============================================================
// RENDER
// ============================================================
function escapeHTML(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
}

function renderSidebar() {
    const list = document.getElementById('categoryList');
    list.innerHTML = SECTIONS.map((sec, i) => `
        <li>
            <button data-target="section-${sec.id}" class="${i === 0 ? 'active' : ''}">
                <i class="fas ${sec.icon}"></i> ${escapeHTML(sec.title)}
            </button>
        </li>
    `).join('');

    list.querySelectorAll('button').forEach(btn => {
        btn.addEventListener('click', () => {
            const target = document.getElementById(btn.dataset.target);
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            list.querySelectorAll('button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        });
    });
}

function renderSections() {
    const container = document.getElementById('sections');
    container.innerHTML = SECTIONS.map(sec => `
        <section class="category-section" id="section-${sec.id}">
            <h2 class="category-header"><i class="fas ${sec.icon}"></i> ${escapeHTML(sec.title)}</h2>
            <div class="movie-grid">
                ${sec.items.map(item => `
                    <div class="movie-card">
                        <a href="${escapeHTML(item.url)}" data-title="${escapeHTML(item.title)}" target="_blank" rel="noopener">
                            ${escapeHTML(item.title)}${item.rating ? `<span class="rating">${item.rating}</span>` : ''}
                        </a>
                    </div>
                `).join('')}
            </div>
        </section>
    `).join('');
}

renderSidebar();
renderSections();

// ---- search ----
const searchBar = document.getElementById('searchBar');
const emptyState = document.getElementById('emptyState');

searchBar.addEventListener('input', () => {
    const filter = searchBar.value.trim().toUpperCase();
    let anyVisible = false;

    document.querySelectorAll('.category-section').forEach(section => {
        let sectionHasMatch = false;
        section.querySelectorAll('.movie-card').forEach(card => {
            const title = card.querySelector('a').dataset.title.toUpperCase();
            const match = title.includes(filter);
            card.style.display = match ? '' : 'none';
            if (match) sectionHasMatch = true;
        });
        section.style.display = (filter === '' || sectionHasMatch) ? '' : 'none';
        if (sectionHasMatch || filter === '') anyVisible = true;
    });

    emptyState.style.display = anyVisible ? 'none' : 'block';
});
</script>

